    class="container-site flex flex-col items-center justify-between gap-3 text-sm text-muted sm:flex-row"
  >
    <p>© {ano} {site.nome}</p>
    <p class="font-mono text-xs">Feito com Astro e Tailwind CSS</p>
  </div>
</footer>
