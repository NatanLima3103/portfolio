---
import { site } from '../data/site';
import Reveal from './Reveal.astro';

const contatos = [
  {
    rotulo: 'E-mail',
    valor: site.email,
    href: `mailto:${site.email}`,
    externo: false,
    icone:
      'M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Zm0 .5 9 6 9-6',
  },
  {
    rotulo: 'LinkedIn',
    valor: 'Perfil profissional',
    href: site.links.linkedin,
    externo: true,
    icone:
      'M4.5 9.5h3v10h-3v-10Zm1.5-5a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5ZM10.5 9.5h3v1.4a3.4 3.4 0 0 1 3-1.6c2.2 0 3.5 1.4 3.5 4v6.2h-3v-5.6c0-1.3-.5-2-1.6-2-1.2 0-1.9.8-1.9 2.1v5.5h-3v-10Z',
  },
  {
    rotulo: 'GitHub',
    valor: 'Repositórios e código',
    href: site.links.github,
    externo: true,
    icone:
      'M12 3a9 9 0 0 0-2.85 17.54c.45.08.62-.2.62-.45v-1.6c-2.5.55-3.03-1.2-3.03-1.2-.41-1.04-1-1.32-1-1.32-.82-.56.06-.55.06-.55.9.07 1.38.93 1.38.93.8 1.38 2.1.98 2.62.75.08-.58.31-.98.57-1.2-2-.23-4.1-1-4.1-4.45 0-.98.35-1.79.93-2.42-.1-.23-.4-1.15.09-2.4 0 0 .75-.24 2.46.92a8.5 8.5 0 0 1 4.48 0c1.7-1.16 2.45-.92 2.45-.92.5 1.25.19 2.17.1 2.4.58.63.92 1.44.92 2.42 0 3.46-2.1 4.22-4.1 4.44.32.28.6.82.6 1.65v2.45c0 .25.17.54.63.45A9 9 0 0 0 12 3Z',
  },
];
---

<div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-center">
  <p class="max-w-xl text-base leading-relaxed text-muted sm:text-lg">
    Estou aberto a conversar sobre backend, automação e oportunidades. O caminho mais rápido é
    o e-mail.
  </p>
</div>

<ul class="mt-8 grid gap-4 sm:grid-cols-3">
  {
    contatos.map((contato, i) => (
      <Reveal as="li" delay={i * 70}>
        <a
          href={contato.href}
          target={contato.externo ? '_blank' : undefined}
          rel={contato.externo ? 'noopener noreferrer' : undefined}
          class="flex h-full items-center gap-3 rounded-xl border border-borda bg-surface p-4 transition-colors hover:border-accent/50 hover:bg-surface-2"
        >
          <span
            class="grid size-10 shrink-0 place-items-center rounded-lg bg-accent-soft text-accent"
            aria-hidden="true"
          >
            <svg
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={contato.icone} />
            </svg>
          </span>

          <span class="min-w-0">
            <span class="block font-mono text-xs tracking-wide text-muted uppercase">
              {contato.rotulo}
            </span>
            <span class="block truncate text-sm font-medium">{contato.valor}</span>
          </span>
        </a>
      </Reveal>
    ))
  }
</ul>
