---
import { site, navegacao } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  comNavegacao?: boolean;
}

const { comNavegacao = false } = Astro.props;

// Fora da home as âncoras precisam voltar para "/" antes do #
const base = comNavegacao ? '' : '/';
---

<header
  class="sticky top-0 z-40 border-b border-borda/80 bg-bg/80 backdrop-blur-md supports-[backdrop-filter]:bg-bg/65"
>
  <div class="container-site flex h-16 items-center justify-between gap-3">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2 rounded-md font-semibold tracking-tight"
      aria-label={`${site.nome} — início`}
    >
      <span
        class="grid size-8 place-items-center rounded-md bg-accent-soft font-mono text-[13px] font-medium text-accent"
        aria-hidden="true">NJ</span
      >
      <span class="hidden text-sm sm:inline">{site.nomeCurto}</span>
    </a>

    <div class="flex items-center gap-2 sm:gap-4">
      {
        comNavegacao && (
          <nav aria-label="Seções do site">
            <ul class="flex items-center gap-3 text-[13px] sm:gap-5 sm:text-sm">
              {navegacao.map((item) => (
                <li>
                  <a
                    href={`${base}${item.href}`}
                    class="rounded text-muted transition-colors hover:text-texto"
                  >
                    {item.texto}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        !comNavegacao && (
          <a href="/#projetos" class="text-[13px] text-muted transition-colors hover:text-texto sm:text-sm">
            ← Projetos
          </a>
        )
      }

      <ThemeToggle />
    </div>
  </div>
</header>
