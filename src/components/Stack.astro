---
import { stack } from '../data/site';
import Badge from './Badge.astro';
import Reveal from './Reveal.astro';
---

<div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
  {
    stack.map((grupo, i) => (
      <Reveal delay={i * 60}>
        <h3 class="font-mono text-xs tracking-wider text-muted uppercase">{grupo.categoria}</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {grupo.itens.map((item) => (
            <li>
              <Badge>{item}</Badge>
            </li>
          ))}
        </ul>
      </Reveal>
    ))
  }
</div>
