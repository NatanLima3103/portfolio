---
import { stack } from '../data/site';
import Badge from './Badge.astro';
import Reveal from './Reveal.astro';
---

<div class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
  {
    stack.map((grupo, i) => (
      <Reveal delay={i * 60}>
        <h3
          class:list={[
            'font-mono text-xs tracking-wider uppercase',
            grupo.estudando ? 'text-accent' : 'text-muted',
          ]}
        >
          {grupo.categoria}
        </h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {grupo.itens.map((item) => (
            <li>
              <Badge variante={grupo.estudando ? 'contorno' : 'tecnologia'}>{item}</Badge>
            </li>
          ))}
        </ul>
      </Reveal>
    ))
  }
</div>
