---
interface Props {
  /** 'tecnologia' = badge neutra | 'destaque' = badge na cor de destaque */
  variante?: 'tecnologia' | 'destaque';
}

const { variante = 'tecnologia' } = Astro.props;

const estilos = {
  tecnologia: 'border-borda bg-surface-2 text-muted',
  destaque: 'border-transparent bg-accent-soft text-accent',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-md border px-2 py-0.5 font-mono text-xs whitespace-nowrap',
    estilos[variante],
  ]}
>
  <slot />
</span>
