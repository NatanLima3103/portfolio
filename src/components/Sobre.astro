---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { site, sobre } from '../data/site';

// A foto vive em public/, então o Astro não a processa. Verificamos a existência
// em tempo de build para poder cair no monograma quando o arquivo não estiver lá.
// O caminho parte da raiz do projeto (process.cwd()), e não de import.meta.url:
// no build este componente é empacotado em outra pasta, e um caminho relativo a
// ele apontaria para o lugar errado — a foto nunca seria encontrada.
const caminhoFoto = join(process.cwd(), 'public', site.foto);
const temFoto = existsSync(caminhoFoto);
---

<div class="grid gap-10 sm:gap-12 md:grid-cols-[14rem_1fr] md:items-start md:gap-14">
  <div class="mx-auto w-40 sm:w-48 md:mx-0 md:w-56">
    {
      temFoto ? (
        <img
          src={site.foto}
          alt={`Retrato de ${site.nome}`}
          width="448"
          height="448"
          loading="lazy"
          decoding="async"
          class="aspect-square w-full rounded-2xl border border-borda object-cover"
        />
      ) : (
        <div
          class="grid aspect-square w-full place-items-center rounded-2xl border border-borda bg-surface"
          role="img"
          aria-label={`Foto de ${site.nome} ainda não disponível`}
        >
          <span class="font-mono text-4xl font-medium text-accent sm:text-5xl" aria-hidden="true">
            NJ
          </span>
        </div>
      )
    }
  </div>

  <div>
    <div class="space-y-4 text-base leading-relaxed text-muted sm:text-lg">
      {sobre.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
    </div>

    <dl class="mt-8 grid gap-4 border-t border-borda pt-6 sm:grid-cols-2">
      <div>
        <dt class="font-mono text-xs tracking-wide text-muted uppercase">Formação</dt>
        <dd class="mt-1 text-sm">{site.formacao}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs tracking-wide text-muted uppercase">Foco</dt>
        <dd class="mt-1 text-sm">Backend com Java e Spring Boot, automação e microsserviços</dd>
      </div>
    </dl>
  </div>
</div>
